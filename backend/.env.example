# NeonDB の接続文字列
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/hangulme?sslmode=require

PORT=8080

# Clerk の Frontend API URL（JWKS取得元）。未設定なら開発用の簡易認証で起動します
CLERK_ISSUER=
CLERK_AUDIENCE=

# 未設定ならAIフォールバックは無効（DB曖昧検索のみで動作）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

ALLOWED_ORIGINS=http://localhost:5173

# 閲覧生ログの保持日数（これを過ぎた分は日次集計に丸めて削除）
VIEW_RETENTION_DAYS=90
