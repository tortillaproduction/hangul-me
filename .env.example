# docker compose が読み込む環境変数のひな形。
# このファイルを .env にコピーして使ってください（.env は commit しません）。

# --- フロントエンド（必須） -------------------------------------------------
# Clerk の Publishable Key。未設定だと frontend の起動が止まります。
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx

# バインドマウントでファイル変更が検知されない場合のみ true
VITE_USE_POLLING=false

# --- 認証（任意） -----------------------------------------------------------
# 未設定の場合、バックエンドは開発用の簡易認証で起動します
# （Authorization: Bearer <任意の文字列> がそのままユーザー識別子になります）。
CLERK_ISSUER=
CLERK_AUDIENCE=

# --- AI補完（任意） ---------------------------------------------------------
# 未設定ならDBの曖昧検索のみで動作します。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- ローカルDB -------------------------------------------------------------
POSTGRES_USER=hangulme
POSTGRES_PASSWORD=hangulme
POSTGRES_DB=hangulme
POSTGRES_PORT=5432

# --- ポート -----------------------------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=5173

# --- その他 -----------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173
VIEW_RETENTION_DAYS=90
