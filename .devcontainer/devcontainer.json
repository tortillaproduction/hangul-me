{
  "name": "Hangul-me",

  // Go を土台にして、Node / Docker / GitHub CLI / Claude Code を features で足す
  "image": "mcr.microsoft.com/devcontainers/go:1-1.24-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    // コンテナ内から docker compose を使えるようにする
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    // Claude Code CLI（Node/npm に依存するため node feature の後に入る）
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        // AI / エージェント
        "anthropic.claude-code",
        "Codeium.codeium", // Windsurf Plugin（旧 Codeium）
        // コンテナ
        "ms-azuretools.vscode-docker",
        // Go
        "golang.go",
        // JavaScript / TypeScript / React
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "burkeholland.simple-react-snippets",
        "abusaidm.html-snippets",
        // 編集支援
        "Cardinal90.multi-cursor-case-preserve",
        // 外観
        "mightbesimon.emoji-icons"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "files.eol": "\n",
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true,
        "workbench.iconTheme": "emoji-file-icons",

        "[go]": {
          "editor.defaultFormatter": "golang.go",
          "editor.codeActionsOnSave": { "source.organizeImports": "explicit" }
        },
        "go.lintTool": "staticcheck",
        "go.testFlags": ["-v"],
        "gopls": { "ui.semanticTokens": true },

        "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

        "eslint.workingDirectories": ["frontend"],
        "tailwindCSS.experimental.classRegex": [
          ["className=\"([^\"]*)\"", "([a-zA-Z0-9\\-:\\[\\]\\/\\.%]+)"]
        ],

        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  // compose と同じポートを転送する
  "forwardPorts": [5173, 8080, 5432],
  "portsAttributes": {
    "5173": { "label": "frontend (Vite)", "onAutoForward": "notify" },
    "8080": { "label": "backend (Go API)", "onAutoForward": "silent" },
    "5432": { "label": "postgres", "onAutoForward": "silent" }
  },

  // 依存の取得までを自動で済ませる
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "remoteUser": "vscode",

  // Claude Code の認証情報と gh のログイン状態をコンテナ再作成後も保つ
  "mounts": [
    "source=hangulme-claude-config,target=/home/vscode/.claude,type=volume",
    "source=hangulme-gh-config,target=/home/vscode/.config/gh,type=volume"
  ],

  "remoteEnv": {
    // ホスト側で設定していればコンテナへ引き継ぐ（未設定でも起動はできる）
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  }
}
